# Run `node scripts/setup-local.mjs` instead of copying this placeholder.
# Use alphanumeric or hex DB_PASSWORD (a literal @ or : needs URL encoding).
DB_PASSWORD=CHANGE_ME_TO_RANDOM_HEX
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
DATABASE_URL=postgres://pos:CHANGE_ME_TO_RANDOM_HEX@127.0.0.1:5432/pos_saas
PORT=4000

# v9.1 platform console: different random secret, at least 32 chars; never reuse JWT_SECRET.
# PLATFORM_JWT_SECRET=SET_A_SEPARATE_RANDOM_SECRET

# v9.2: 32 random bytes encoded as 64 hex chars; keep stable and back up securely.
# NOTIFICATION_ENCRYPTION_KEY=SET_64_RANDOM_HEX_CHARACTERS
NOTIFICATIONS_WORKER_ENABLED=1
